WORDPRESS_GRAPHQL_URL=https://your-wordpress-site.com/graphql
RESEND_API_KEY=re_your_api_key
CONTACT_TO_EMAIL=you@example.com
# Must be on a domain verified in Resend (or onboarding@resend.dev while testing)
CONTACT_FROM_EMAIL=contact@your-domain.com
# Shared secret for POST /api/revalidate, the WordPress webhook that purges the CDN cache.
# Generate one with: openssl rand -hex 32
REVALIDATE_SECRET=long-random-string
